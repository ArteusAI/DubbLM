# DubbLM environment
#
# The default Fast/HQ/Ultra profiles work with a single OpenRouter key.
# The first-run web wizard writes it to this file automatically.
OPENROUTER_API_KEY=

# Optional legacy / advanced providers. Not required for the default profiles.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# ASSEMBLYAI_API_KEY=
# HF_TOKEN=
# MINIMAX_API_KEY=

# LLM call timeout and retry/backoff configuration
LLM_CALL_TIMEOUT_SECONDS=180
LLM_CALL_MAX_ATTEMPTS=3
LLM_CALL_BACKOFF_INITIAL=1.0
LLM_CALL_BACKOFF_MAX=60.0
LLM_CALL_BACKOFF_FACTOR=2.0

# ИИ Борщ publishing (disabled by default)
BORSCH_PUBLISH_ENABLED=false
BORSCH_API_URL=http://37.27.141.35
BORSCH_PUBLIC_URL=http://37.27.141.35
BORSCH_S3_BUCKET=arteus-pub
BORSCH_S3_PREFIX=videos
BORSCH_CHANNEL=ИИ Борщ
BORSCH_METADATA_LANGUAGE=auto
BORSCH_PUBLISH_TIMEOUT=1800
