# DubbLM Environment Variables
# Copy this file to .env and fill in your values

# The default profiles require only this key.
OPENROUTER_API_KEY=sk-or-...

# Optional legacy / advanced providers.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# HF_TOKEN=hf_...
# ASSEMBLYAI_API_KEY=...
# MINIMAX_API_KEY=...

# Database (default: SQLite)
DATABASE_URL=sqlite:///./dubblm.db

# Redis (default: localhost)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Project storage
PROJECTS_DIR=./projects
# Keep artifacts/cache on disk after S3 archive (default: delete them)
KEEP_DEBUG_ARTIFACTS=false

# Hetzner Object Storage / S3-compatible (optional)
# When configured, source video + results are uploaded after successful dubbing
# and removed from local disk. Download APIs stream from S3.
S3_ENABLED=true
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=fsn1
S3_PREFIX=dubblm
# Presigned share link lifetime in seconds (default: 7 days)
S3_PRESIGN_EXPIRES=604800

# Video download settings
# Optional path to a cookies.txt file for age-restricted/private videos (yt-dlp)
VIDEO_DOWNLOAD_COOKIES_PATH=
# Maximum downloaded video size in bytes (default: 8GB)
MAX_DOWNLOAD_SIZE=8589934592
# Optional maximum video duration in seconds
MAX_DOWNLOAD_DURATION=

# GPU settings (for workers)
CUDA_VISIBLE_DEVICES=0

# API settings
SECRET_KEY=your-secret-key-change-in-production

# ИИ Борщ publishing (disabled by default)
BORSCH_PUBLISH_ENABLED=false
BORSCH_API_URL=http://37.27.141.35
BORSCH_PUBLIC_URL=http://37.27.141.35
BORSCH_S3_BUCKET=arteus-pub
BORSCH_S3_PREFIX=videos
BORSCH_CHANNEL=ИИ Борщ
BORSCH_METADATA_LANGUAGE=auto
BORSCH_PUBLISH_TIMEOUT=1800
